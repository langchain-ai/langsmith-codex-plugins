{
  "name": "@langchain/langsmith-codex-plugins",
  "version": "0.0.0",
  "description": "OpenAI Codex Plugins for LangSmith",
  "keywords": [
    "codex",
    "langsmith",
    "openai"
  ],
  "homepage": "https://github.com/langchain-ai/langsmith-codex-plugins#readme",
  "bugs": {
    "url": "https://github.com/langchain-ai/langsmith-codex-plugins/issues"
  },
  "license": "MIT",
  "author": "LangChain",
  "repository": {
    "type": "git",
    "url": "https://github.com/langchain-ai/langsmith-codex-plugins.git"
  },
  "files": [
    ".codex-plugin",
    "hooks",
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config plugins/tracing/tsdown.config.ts",
    "build:binary": "langsmith-plugin-binary build",
    "sign:binary": "langsmith-plugin-binary sign",
    "installer": "langsmith-plugin-binary installer",
    "test": "vitest",
    "test:binary": "vitest run plugins/tracing/test/binary.test.ts plugins/tracing/test/build-binary.test.ts plugins/tracing/test/install-binary.test.ts",
    "test:hooks": "vitest run plugins/tracing/test/hook-command.test.ts",
    "test:install": "bash node_modules/@langchain/langsmith-plugin-binary/test/install/cases.sh",
    "test:install:mutations": "bash node_modules/@langchain/langsmith-plugin-binary/test/install/variants.sh",
    "format": "oxfmt",
    "lint": "pnpm run lint:oxfmt && pnpm run lint:tsc && pnpm run lint:installer && pnpm run lint:dist",
    "lint:oxfmt": "oxfmt --check",
    "lint:tsc": "tsc --noEmit",
    "lint:installer": "langsmith-plugin-binary installer --check",
    "lint:dist": "pnpm run build && git diff --exit-code -- plugins/tracing/dist/index.mjs"
  },
  "dependencies": {
    "langsmith": "^0.9.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@langchain/langsmith-plugin-binary": "github:langchain-ai/langsmith-plugin-binary#v0.1.0",
    "@types/node": "^26.4.0",
    "memfs": "^4.68.2",
    "oxfmt": "^0.65.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
