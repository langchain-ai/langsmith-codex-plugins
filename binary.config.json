{
  "executableName": "langsmith-codex-tracing",
  "repository": "langchain-ai/langsmith-codex-plugins",
  "build": {
    "entryPoint": "plugins/tracing/src/index.ts",
    "outputDirectory": "plugins/tracing/bin",
    "versionFile": "plugins/tracing/.codex-plugin/plugin.json",
    "minify": true,
    "stampedVersionFiles": ["plugins/tracing/dist/index.mjs"]
  },
  "sign": {
    "entitlements": "macos-entitlements.plist"
  }
}
