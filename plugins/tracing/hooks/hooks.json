{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/binary/langsmith-tracing\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/dist/index.mjs\"",
            "timeout": 30,
            "statusMessage": "Uploading Codex trace to LangSmith"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/binary/langsmith-tracing\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/dist/index.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/binary/langsmith-tracing\" --record-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}/dist/index.mjs\" --record-hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/binary/langsmith-tracing\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/dist/index.mjs\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/binary/langsmith-tracing\" --record-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}/dist/index.mjs\" --record-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/binary/langsmith-tracing\" --record-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}/dist/index.mjs\" --record-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/binary/langsmith-tracing\" --record-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}/dist/index.mjs\" --record-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
